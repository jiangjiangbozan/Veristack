# PostgreSQL 连接与初始化
POSTGRES_USER=veristack
POSTGRES_PASSWORD=veristack
POSTGRES_DB=veristack
POSTGRES_PORT=5432

# API 服务
API_PORT=8080
VERISTACK_AUTH_SECRET=change-me-in-production
VERISTACK_LOGLEVEL=info
VERISTACK_SERVER_ADDR=:8080
# 前端公网地址，用于密码重置与通知邮件里的链接
VERISTACK_SERVER_PUBLICBASEURL=http://localhost:5173

# SMTP 邮件通道；未配置 host 时账户与通知邮件只输出到日志
VERISTACK_SMTP_HOST=
VERISTACK_SMTP_PORT=587
VERISTACK_SMTP_USERNAME=
VERISTACK_SMTP_PASSWORD=
VERISTACK_SMTP_FROM=
VERISTACK_SMTP_FROMNAME=Veristack

# 对象存储，一期仅支持 local
VERISTACK_STORAGE_DRIVER=local
VERISTACK_STORAGE_LOCALROOT=./data

# Web
WEB_PORT=5173
VITE_API_BASE_URL=/api/v1
